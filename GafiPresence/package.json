{
  "name": "gafipresence",
  "version": "0.1.0",
  "private": true,
  "description": "A customizable desktop editor for Discord Rich Presence.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "1.5.1"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.gafipro.gafipresence",
    "productName": "GafiPresence",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "GafiPresence-0.1.0-Portable.exe"
    }
  }
}
